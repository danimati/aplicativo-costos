@startuml clases-front-modelos
!include _estilo.iuml
left to right direction
title Clases del dominio — modelos del frontend (src/app/core/models)
hide empty methods
skinparam linetype ortho

class Project <<interface>> {
  id: string
  name: string
  status: string
  cutDate: string
  progress: string
  family: string
  owner: string
  startDate: string
  endDate: string
}
class ProjectStage <<interface>> {
  id: string
  name: string
  status: string
  progress: number
  owner: string
  dueDate: string
}
class NavCycle <<interface>> {
  id: string
  label: string
}
class NavLeaf <<interface>> {
  id: string
  label: string
  route: string
}
class BomMaterial <<interface>> {
  id: string
  description: string
  supplier: string
  calcType: 'EXACTO' | 'ESTIMADO'
  quantity: string
  unitPrice: string
  subtotal: string
  note: string
}
class LaborStage <<interface>> {
  id, projectId: string
  name: string
  estimatedHours: number
  hourlyRate: number
  owner: string
  status: LaborStageStatus
  notes?: string
}
class ProjectCostInputs <<interface>> {
  projectId: string
  fixedCosts: number
  variableCosts: number
  indirectCosts: number
  marginPercent: number
}
class ProjectTemplateSnapshot <<interface>> {
  templateName, version, family: string
  author, appliedAt: string
  status: TemplateStatus
}
class TemplateInheritedBlock <<interface>> {
  label, source: string
  overridden: boolean
}
class ProcurementItem <<interface>> {
  materialId, materialDescription, supplier
  quotationRef: string
  unitPrice, discountPercent: number
  quantity, receivedQuantity: number
  status: ProcurementStatus
  expectedDate, owner: string
}
class ReceptionItem <<interface>> {
  materialId, lotRef: string
  requestedQuantity, receivedQuantity: number
  receivedDate: string | null
  status: ReceptionStatus
  incidentNote?: string
}
class ProductionActivity <<interface>> {
  stage, description, owner: string
  status: ProductionStatus
  progress: number
  targetDate: string
}
class AssemblyUnit <<interface>> {
  name, owner: string
  status: ProductionStatus
  progress: number
  dependsOn: string[]
}
class InstallationActivity <<interface>> {
  activity, location, owner: string
  status, progress, targetDate
  prerequisite?, notes?: string
}
class WiringCircuit <<interface>> {
  circuitRef, origin, destination, gauge: string
  quantity: number
  status: WiringStatus
  qcPending: boolean
}
class ProgrammingEntry <<interface>> {
  controller, programVersion, owner: string
  status: ProgrammingStatus
  reviewDate: string
  blockers?: string
}
class ProgrammingMilestone <<interface>> {
  label: string
  done: boolean
}
class TestCase <<interface>> {
  protocol, owner, date: string
  result: TestResult
  evidenceRef?, notes?: string
}
class ProjectNote <<interface>> {
  id, projectId, date: string
  content: string  // Markdown
}
class ProjectDocument <<interface>> {
  id, projectId, title: string
  kind: 'markdown' | 'file'
  content: string
  fileName?, fileUrl?, mimeType?: string
  updatedAt: string
}
class Notification <<interface>> {
  id, date, message: string
  read: boolean
  projectId?: string
}
class ProjectCostReport <<interface>> {
  materials, labor: number
  fixedCosts, variableCosts, indirectCosts: number
  totalCost, marginPercent: number
  estimatedProfit, finalEstimatedValue: number
  breakdown: CostBreakdownItem[]
  actualCostAvailable: boolean
}

Project "1" *-- "0..*" ProjectStage : stages
Project "1" *-- "0..*" NavCycle : navTemplate
NavCycle "1" *-- "1..*" NavLeaf : leaves
Project "1" -- "0..*" BomMaterial
Project "1" -- "0..*" LaborStage
Project "1" -- "0..1" ProjectCostInputs
Project "1" -- "0..1" ProjectTemplateSnapshot
ProjectTemplateSnapshot *-- "1..*" TemplateInheritedBlock : blocks
Project "1" -- "0..*" ProcurementItem
Project "1" -- "0..*" ReceptionItem
Project "1" -- "0..*" ProductionActivity
Project "1" -- "0..*" AssemblyUnit
AssemblyUnit --> AssemblyUnit : dependsOn
Project "1" -- "0..*" InstallationActivity
Project "1" -- "0..*" WiringCircuit
Project "1" -- "0..*" ProgrammingEntry
ProgrammingEntry *-- "0..*" ProgrammingMilestone : milestones
Project "1" -- "0..*" TestCase
Project "1" -- "0..*" ProjectNote
Project "1" -- "0..*" ProjectDocument
Notification "0..*" --> "0..1" Project
ProjectCostReport ..> BomMaterial : deriva de
ProjectCostReport ..> LaborStage : deriva de
ProjectCostReport ..> ProjectCostInputs : deriva de
@enduml
