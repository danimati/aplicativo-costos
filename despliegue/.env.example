# Copiar a .env (`make env`) y ajustar. .env no se versiona.

# PostgreSQL
POSTGRES_USER=costos
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=costos

# Puerto público de Nginx (front + /api)
HTTP_PORT=8080

# Workers de uvicorn
WEB_CONCURRENCY=2

# Orígenes permitidos para llamadas directas al API (separados por coma)
CORS_ORIGINS=http://localhost:8080
